# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/

# Coverage reports (generated by `pytest --cov`, see pytest.ini / test.yml)
.coverage
.coverage.*
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/
*.egg-info/
.eggs/

# Virtual environments (this project uses .venv)
.venv/
venv/
env/
ENV/

# ---------------------------------------------------------------------------
# PyInstaller build output (see docs/BUILD_INSTRUCTIONS.md — never commit
# platform-specific binaries; every user builds their own)
# ---------------------------------------------------------------------------
build/
dist/
*.spec
!packaging/macos/ESP32MultiFlashManager.spec

# ---------------------------------------------------------------------------
# Application runtime data (settings/logs/profiles live under the per-OS
# app-data directory outside the repo — see app/utilities/helpers.py — but
# ignore local scratch data if it's ever created next to the source tree)
# ---------------------------------------------------------------------------
logs/
*.log

# ---------------------------------------------------------------------------
# OS junk files
# ---------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
System Volume Information
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.directory
.Trash-*

# ---------------------------------------------------------------------------
# Editors / IDEs
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo

# ---------------------------------------------------------------------------
# Project-specific
# ---------------------------------------------------------------------------
# Internal maintenance script — not part of the public deliverable
repo_maintenance.py

# User-created project files saved outside examples/ during local testing
/*.emfm
/*.efmproj

# Hypothesis fuzz-test example database (local cache, not deterministic
# across machines/runs)
.hypothesis/
